{
  "name": "Sale",
  "type": "object",
  "properties": {
    "transaction_date": {
      "type": "string",
      "format": "date-time",
      "title": "Transaction Date"
    },
    "cashier_name": {
      "type": "string",
      "title": "Cashier Name"
    },
    "items": {
      "type": "array",
      "title": "Items",
      "items": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "items_count": {
      "type": "number",
      "title": "Items Count"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "vat": {
      "type": "number",
      "title": "VAT (12%)"
    },
    "total": {
      "type": "number",
      "title": "Total Amount Due"
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method",
      "enum": [
        "Cash",
        "GCash",
        "Maya"
      ]
    },
    "cash_tendered": {
      "type": "number",
      "title": "Cash Tendered"
    },
    "change_given": {
      "type": "number",
      "title": "Change Given"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Completed",
        "Voided",
        "Refunded"
      ],
      "default": "Completed"
    }
  },
  "required": [
    "transaction_date",
    "cashier_name",
    "total",
    "status"
  ]
}